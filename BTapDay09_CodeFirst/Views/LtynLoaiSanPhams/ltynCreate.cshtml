@model BTapDay09_CodeFirst.Models.DataModels.LtynLoaiSanPham

@{
    ViewData["Title"] = "ltynCreate";
}

<h1>Thêm loại sản phẩm</h1>

<h4>LtynLoaiSanPham</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="ltynCreate">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ltynMaLoai" class="control-label"></label>
                <input asp-for="ltynMaLoai" class="form-control" />
                <span asp-validation-for="ltynMaLoai" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ltynTenLoai" class="control-label"></label>
                <input asp-for="ltynTenLoai" class="form-control" />
                <span asp-validation-for="ltynTenLoai" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ltynTrangThai" class="control-label"></label>
                <input asp-for="ltynTrangThai" class="form-control" />
                <span asp-validation-for="ltynTrangThai" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Thêm mới" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="ltynIndex" class="btn btn-secondary">Quay lại danh sách</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
