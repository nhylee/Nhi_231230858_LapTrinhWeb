@model BTapDay09_CodeFirst.Models.DataModels.LtynLoaiSanPham

@{
    ViewData["Title"] = "Chi tiết loại sản phẩm";
}

<h1>Chi tiết loại sản phẩm</h1>
<hr />

<dl class="row">
    <dt class="col-sm-2">Mã loại</dt>
    <dd class="col-sm-10">@Model.ltynMaLoai</dd>

    <dt class="col-sm-2">Tên loại</dt>
    <dd class="col-sm-10">@Model.ltynTenLoai</dd>

    <dt class="col-sm-2">Trạng thái</dt>
    <dd class="col-sm-10">@((Model.ltynTrangThai == true) ? "Kích hoạt" : "Ẩn")</dd>
</dl>

<div>
    <a asp-action="ltynEdit" asp-route-id="@Model.ltynID" class="btn btn-warning">Sửa</a>
    <a asp-action="ltynIndex" class="btn btn-secondary ms-2">Quay lại</a>
</div>
