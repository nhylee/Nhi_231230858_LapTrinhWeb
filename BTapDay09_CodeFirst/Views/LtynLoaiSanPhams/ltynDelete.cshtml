@model BTapDay09_CodeFirst.Models.DataModels.LtynLoaiSanPham

@{
    ViewData["Title"] = "Xóa loại sản phẩm";
}

<h1>Xóa loại sản phẩm</h1>
<hr />

<h4>Bạn có chắc chắn muốn xóa loại sản phẩm này?</h4>

<dl class="row">
    <dt class="col-sm-2">Mã loại</dt>
    <dd class="col-sm-10">@Model.ltynMaLoai</dd>

    <dt class="col-sm-2">Tên loại</dt>
    <dd class="col-sm-10">@Model.ltynTenLoai</dd>
</dl>

<form asp-action="ltynDeleteConfirmed">
    <input type="hidden" asp-for="ltynID" />
    <input type="submit" value="Xóa" class="btn btn-danger" />
    <a asp-action="ltynIndex" class="btn btn-secondary ms-2">Hủy</a>
</form>
