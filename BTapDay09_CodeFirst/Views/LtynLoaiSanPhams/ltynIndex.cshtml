@model IEnumerable<BTapDay09_CodeFirst.Models.DataModels.LtynLoaiSanPham>

@{
    ViewData["Title"] = "Danh sách loại sản phẩm";
}

<h1>Danh sách loại sản phẩm</h1>

<p>
    <a asp-action="ltynCreate" class="btn btn-success">+ Thêm loại sản phẩm</a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().ltynMaLoai)</th>
            <th>@Html.DisplayNameFor(model => model.First().ltynTenLoai)</th>
            <th>@Html.DisplayNameFor(model => model.First().ltynTrangThai)</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ltynMaLoai</td>
                <td>@item.ltynTenLoai</td>
                <td>@(item.ltynTrangThai == true ? "Kích hoạt" : "Ẩn")</td>
                <td>
                    <a asp-action="ltynDetails" asp-route-id="@item.ltynID" class="btn btn-info btn-sm">Xem</a>
                    <a asp-action="ltynEdit" asp-route-id="@item.ltynID" class="btn btn-warning btn-sm">Sửa</a>
                    <a asp-action="ltynDelete" asp-route-id="@item.ltynID" class="btn btn-danger btn-sm">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
