@model BTapDay09_CodeFirst.Models.DataModels.LtynLoaiSanPham

@{
    ViewData["Title"] = "Sửa loại sản phẩm";
}

<h1>Sửa loại sản phẩm</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="ltynEdit">
            <input type="hidden" asp-for="ltynID" />

            <div class="form-group mb-3">
                <label asp-for="ltynMaLoai" class="form-label"></label>
                <input asp-for="ltynMaLoai" class="form-control" />
                <span asp-validation-for="ltynMaLoai" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ltynTenLoai" class="form-label"></label>
                <input asp-for="ltynTenLoai" class="form-control" />
                <span asp-validation-for="ltynTenLoai" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ltynTrangThai" class="form-label"></label>
                <input asp-for="ltynTrangThai" class="form-check-input" type="checkbox" />
                <span asp-validation-for="ltynTrangThai" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Lưu thay đổi" class="btn btn-warning" />
                <a asp-action="ltynIndex" class="btn btn-secondary ms-2">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
